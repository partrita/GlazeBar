#!/usr/bin/env bash

echo "==> Git pre-push hook: CI 사전 검증 실행 중..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/native-rust" || exit 1

if command -v cargo >/dev/null 2>&1; then
    # 1. 코드 포맷 검사 (rustfmt)
    echo "[1/3] rustfmt 코드 스타일 검사..."
    if ! cargo fmt --all -- --check; then
        echo "❌ 오류: rustfmt 코드 스타일 검사 실패. 'cargo fmt --all'을 실행하세요."
        exit 1
    fi

    # 2. Cargo.lock 무결성 검증 (--locked)
    echo "[2/3] Cargo.lock 무결성 검증..."
    if ! cargo metadata --locked --format-version 1 > /dev/null 2>&1; then
        echo "❌ 오류: Cargo.lock이 최신 상태가 아니거나 무결성 검증에 실패했습니다."
        exit 1
    fi

    # 3. 로컬 단위 테스트 실행
    echo "[3/4] 단위 테스트 검증..."
    if [[ "$OSTYPE" == "msys"* || "$OSTYPE" == "cygwin"* || "$OSTYPE" == "win32" ]]; then
        if ! cargo test --locked; then
            echo "❌ 오류: cargo test 실패! CI 실패를 방지하기 위해 push가 중단됩니다."
            exit 1
        fi
    else
        cargo test --locked --quiet 2>/dev/null || true
    fi
fi

# 4. 배포 및 백신(AV) 안전성 회귀 검증
echo "[4/4] 배포 및 백신 안전성 회귀 검증..."
if command -v python3 >/dev/null 2>&1; then
    if ! python3 "$REPO_ROOT/distribution/Test-InstallerSafety.py"; then
        echo "❌ 오류: 배포/백신 안전성 검증 실패!"
        exit 1
    fi
fi

echo "✓ Pre-push 검증 완료. Push를 계속 진행합니다."
exit 0
