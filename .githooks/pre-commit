#!/usr/bin/env bash

echo "==> Git pre-commit hook: 코드 스타일 및 서식 검증 실행 중..."

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT/native-rust" || exit 1

if command -v cargo >/dev/null 2>&1; then
    # 1. 코드 포맷 검사 (rustfmt)
    echo "[1/2] rustfmt 코드 스타일 검사..."
    if ! cargo fmt --all -- --check; then
        echo "❌ 오류: rustfmt 코드 스타일 검사 실패. 'cargo fmt --all'을 실행하세요."
        exit 1
    fi

    # 2. Cargo.lock 무결성 검증 (--locked)
    echo "[2/2] Cargo.lock 무결성 검증..."
    if ! cargo metadata --locked --format-version 1 > /dev/null 2>&1; then
        echo "❌ 오류: Cargo.lock이 최신 상태가 아니거나 무결성 검증에 실패했습니다."
        exit 1
    fi
fi

echo "✓ Pre-commit 검증 완료."
exit 0
